{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "icn1"
  ],
  "functions": {
    "app/api/intake/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/agents",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/mails",
      "schedule": "0 0 * * *"
    }
  ]
}
